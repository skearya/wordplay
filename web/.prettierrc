{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": [
		"prettier-plugin-svelte",
		"prettier-plugin-tailwindcss",
		"@ianvs/prettier-plugin-sort-imports"
	],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	],
	"tailwindStylesheet": "./src/app.css",
	"tailwindPreserveWhitespace": false,
	"importOrder": ["<TYPES>", "<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "^\\$lib(/.*)$", "^[.]"]
}
